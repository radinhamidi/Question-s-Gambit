# Question-Gambit — environment variables
#
# Copy this file to .env and fill in the keys you need for the runs you
# intend to reproduce. The .env file is loaded by scripts/run_arm.sh.
#
# Required keys per pipeline component:
#
#  Agent + decomposition (depends on which AGENT_MODEL you pick):
#    OPENAI_API_KEY      — for openai/gpt-5.5, openai/gpt-5.4-mini, gpt-5.3-codex judge
#    OPENROUTER_API_KEY  — for openrouter/deepseek/* agents AND for Cohere reranker
#
#  Agent runtime:
#    MODEL               — the agent model id (e.g. openai/gpt-5.5,
#                          openrouter/deepseek/deepseek-v4-pro)

OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Pi-coding-agent model id (the AGENT)
MODEL=openai/gpt-5.5
